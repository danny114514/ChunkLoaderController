# ============================================================================
#  行尾规范（跨平台协作必需）
#
#  为什么必须有这个文件：
#    Windows 上 git 默认 core.autocrlf=true，会把文本文件转成 CRLF。
#    这对 Java 源码无害，但会把 gradlew（Unix shell 脚本）也转成 CRLF，
#    导致 Linux/macOS 上 `./gradlew build` 直接报
#    "bad interpreter: /bin/sh^M: no such file or directory"。
#    开源项目里这是最常见的「我这里能跑」类问题之一。
# ============================================================================

# 默认：按内容自动判断，文本存为 LF
* text=auto eol=lf

# ── 必须是 LF：Unix 脚本 ────────────────────────────────────────────────────
gradlew text eol=lf

# ── 必须是 CRLF：Windows 批处理（LF 会导致 cmd 解析异常）────────────────────
*.bat text eol=crlf
*.cmd text eol=crlf

# ── 文本类，统一 LF ────────────────────────────────────────────────────────
*.java   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
LICENSE  text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# ── 二进制：禁止任何换行转换 ────────────────────────────────────────────────
*.jar  binary
*.zip  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.db   binary

# ── GitHub 语言统计：把仓库识别为 Java 项目 ────────────────────────────────
*.java linguist-language=Java
